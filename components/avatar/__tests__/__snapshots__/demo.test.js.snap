    </button></div>
  <div class="ant-avatar-group"><span style="background-color: rgb(245, 106, 0);" class="ant-avatar ant-avatar-circle"><span class="ant-avatar-string" style="opacity: 0;">A</span></span><span style="background-color: rgb(245, 106, 0);" class="ant-avatar ant-avatar-circle"><span class="ant-avatar-string" style="opacity: 0;">B</span></span><span style="background-color: rgb(82, 196, 26); color: rgb(255, 255, 255);" class="ant-avatar ant-avatar-circle"><span class="ant-avatar-string" style="opacity: 0;">+2</span></span>
    <!---->
  </div>
</div>
`;

